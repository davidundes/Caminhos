<?xml version="1.0" encoding="utf-8"?>
<com.caminhos.avaliacao.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#E3E9F1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E3E9F1"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/textLegendaFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:padding="5dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/btnRemoverFoto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/bg_circle_dark"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />
</com.caminhos.avaliacao.SquareFrameLayout>