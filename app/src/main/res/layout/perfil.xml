<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ CABEÇALHO ============ -->
            <LinearLayout
                android:id="@+id/perfilHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_perfil_header"
                android:clipChildren="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/textTituloPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meu perfil"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_avatar_anel"
                    android:clipChildren="false"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/perfil_foto"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_avatar_padrao"
                        android:clipToOutline="true"
                        android:contentDescription="Foto de perfil padrão"
                        android:scaleType="centerCrop" />

                    <ImageButton
                        android:id="@+id/btnAlterarFoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-6dp"
                        android:layout_marginBottom="-6dp"
                        android:background="@drawable/bg_perfil_camera"
                        android:contentDescription="Alterar foto de perfil"
                        android:elevation="4dp"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_camera"
                        android:tint="#124477"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/perfil_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/perfil_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#DCEBF8"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/perfil_qtdAvalicoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_perfil_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="0 avaliações"
                    android:textColor="#124477"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============ CONTEÚDO ============ -->
            <LinearLayout
                android:id="@+id/conteudoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <!-- Informações pessoais -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3E9F1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_perfil_acento"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Informações pessoais"
                                android:textColor="#1B2A41"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <include
                            android:id="@+id/campoNome"
                            layout="@layout/item_campo_perfil" />

                        <include
                            android:id="@+id/campoEmail"
                            layout="@layout/item_campo_perfil" />

                        <include
                            android:id="@+id/campoCpf"
                            layout="@layout/item_campo_perfil" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sobre mim -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3E9F1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_perfil_acento"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Sobre mim"
                                android:textColor="#1B2A41"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/perfil_bio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#1B2A41"
                            android:textSize="16sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputBioLayout"
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Sobre mim"
                            android:visibility="gone"
                            app:counterEnabled="true"
                            app:placeholderText="Conte um pouco sobre você...">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputBio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ações: visualização -->
                <LinearLayout
                    android:id="@+id/acoesVisualizacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="56dp"
                        android:text="Editar perfil"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="#0A78B5"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_perfil_editar"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <!-- Ações: edição -->
                <LinearLayout
                    android:id="@+id/acoesEdicao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalvarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="56dp"
                        android:text="Salvar alterações"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="#0A78B5"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelarEdicao"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="52dp"
                        android:text="Cancelar"
                        android:textAllCaps="false"
                        android:textColor="#124477"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:strokeColor="#CBD5E1" />
                </LinearLayout>

                <!-- Sair da conta (separado das informações) -->
                <View
                    android:id="@+id/divisorSair"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="#E3E9F1"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSair"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="52dp"
                    android:text="Sair da conta"
                    android:textAllCaps="false"
                    android:textColor="#B3261E"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="#B3261E" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#FFC928"
        app:trackColor="#00000000" />

    <com.caminhos.ui.HotbarView
        android:id="@+id/hotbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>