<?xml version="1.0" encoding="utf-8"?>
<!-- Uma das 4 opções de classificação. Reutilizada 4x via <include> em item_recurso.xml. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E3E9F1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/textSimbolo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textOpcaoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1B2A41"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textOpcaoExplicacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#5B6B80"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textIndicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textSize="20sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>