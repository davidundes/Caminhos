<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Avalie a acessibilidade do local"
            android:textColor="#1B2A41"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Sua avaliação ajuda outras pessoas"
            android:textColor="#6B7A90"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Nota geral"
            android:textColor="#1B2A41"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/ratingNota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:numStars="5"
            android:progressTint="#21BBFF"
            android:stepSize="1.0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Itens de acessibilidade"
            android:textColor="#1B2A41"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <CheckBox
                android:id="@+id/checkRampa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Rampa de acesso"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkElevador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Elevador"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkBanheiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Banheiro acessível"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkPisoTatil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Piso tátil"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkVagaPcd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Vaga PCD"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Entrada acessível"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkCorrimao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Corrimão"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkPortas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Portas largas"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkSinalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Sinalização acessível"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkIluminacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#21BBFF"
                android:text="Iluminação adequada"
                android:textColor="#1B2A41"
                android:textSize="16sp" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonEnviarAvaliacao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Enviar avaliação"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>