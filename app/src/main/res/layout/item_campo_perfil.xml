<?xml version="1.0" encoding="utf-8"?>
<!-- Um campo do perfil: modo leitura (ícone + rótulo + valor) ou modo edição (TextInputLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/campoLeitura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconeCampo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_perfil_icone"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:tint="#1769AA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rotuloCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5B6B80"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/valorCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1B2A41"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/acaoCampo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="#0A5E8F"
            android:visibility="gone"
            app:strokeColor="#CBD5E1" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutCampo"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>