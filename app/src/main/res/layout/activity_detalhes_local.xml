<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_detalhes_local.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDetalhes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC"
    tools:context=".local.DetalhesLocalActivity">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/barraTopo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/buttonVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="#1B2A41"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Detalhes do local"
            android:textColor="#1B2A41"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetalhes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/buttonAvaliarLocal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barraTopo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Card: informações do local -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textNomeLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1B2A41"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Nome do estabelecimento" />

                <LinearLayout
                    android:id="@+id/rowEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Endereço"
                        android:textColor="#9AA7B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textEnderecoLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#1B2A41"
                        android:textSize="16sp"
                        tools:text="Rua Exemplo, 123 - CEP 12300-000" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone"
                        android:textColor="#9AA7B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textTelefoneLocal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:minHeight="32dp"
                        android:gravity="center_vertical"
                        android:textColor="#21BBFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="(12) 99999-9999" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowHorario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horário de funcionamento"
                        android:textColor="#9AA7B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textHorarioLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#1B2A41"
                        android:textSize="16sp"
                        tools:text="Seg a Sex, 8h às 18h" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: resumo das notas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textMediaNota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1B2A41"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="4,2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textEstrelasMedia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFB400"
                            android:textSize="22sp"
                            tools:text="★★★★☆" />

                        <TextView
                            android:id="@+id/textQtdAvaliacoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#6B7A90"
                            android:textSize="14sp"
                            tools:text="12 avaliações" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Resumo da acessibilidade: situação mais comum de cada critério -->
                <LinearLayout
                    android:id="@+id/blocoAcessibilidadeResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="#E3EAF3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acessibilidade do local"
                        android:textColor="#1B2A41"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="6dp"
                        android:text="Situação mais comum entre as avaliações"
                        android:textColor="#9AA7B8"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/containerAcessibilidadeResumo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Avaliações dos usuários"
                android:textColor="#1B2A41"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSemAvaliacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Este local ainda não foi avaliado."
                android:textColor="#6B7A90"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Os itens (item_avaliacao_local) são adicionados aqui pela Activity -->
            <LinearLayout
                android:id="@+id/containerAvaliacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/buttonAvaliarLocal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:stateListAnimator="@null"
        android:text="Avaliar este local"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progressDetalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>